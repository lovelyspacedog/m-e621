#!/bin/bash
# Pull latest from origin, rebuild dist, restart PawFeed if needed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=load-m-e621-env.sh
source "$ROOT/load-m-e621-env.sh"

APP_DIR="${M_E621_DIR:-$HOME/m-e621}"
CONFIG_DIR="${M_E621_CONFIG:-$HOME/.config/m-e621}"
LOG="$CONFIG_DIR/sync.log"
LOCK="$CONFIG_DIR/sync.lock"
# Wait this many seconds for another sync (agent or cron), then one non-blocking try.
LOCK_TIMEOUT="${M_E621_SYNC_LOCK_TIMEOUT:-600}"
DOMAIN="${M_E621_DOMAIN:-localhost}"
REPO_URL="${M_E621_REPO:-https://github.com/lovelyspacedog/m-e621.git}"
BRANCH="${M_E621_BRANCH:-master}"

mkdir -p "$CONFIG_DIR"

# Serialize overlapping syncs. Blocking wait first; if still busy, non-blocking retry then exit.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK"
  if ! flock -w "$LOCK_TIMEOUT" 9; then
    if ! flock -n 9; then
      msg="sync: lock busy ($LOCK) after ${LOCK_TIMEOUT}s wait + non-blocking retry"
      echo "$msg" >&2
      echo "==== $(date -Is) $msg ====" >>"$LOG"
      exit 75
    fi
  fi
else
  echo "==== $(date -Is) sync warning: flock not found; running without lock ====" >>"$LOG"
fi

exec >>"$LOG" 2>&1
echo "==== $(date -Is) sync start ===="

if [[ ! -d "$APP_DIR/.git" ]]; then
  mkdir -p "$(dirname "$APP_DIR")"
  git clone --branch "$BRANCH" "$REPO_URL" "$APP_DIR"
fi

cd "$APP_DIR"

# Ensure helper scripts exist even on a fresh clone (deploy also rsyncs them).
if [[ ! -x "$APP_DIR/start" || ! -f "$APP_DIR/serve.py" ]]; then
  echo "missing start/serve.py in $APP_DIR — re-run deploy.sh from your laptop" >&2
  exit 1
fi

before="$(git rev-parse HEAD)"

# Helpers may exist as untracked copies from deploy.sh; drop them so ff-merge can land tracked versions.
# Also reset dirty *tracked* copies (rsync from deploy.sh often dirties serve.py before pull).
for f in start sync serve.py deploy.sh load-m-e621-env.sh; do
  if [[ -e "$f" ]] && ! git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
    echo "removing untracked $f so git merge can proceed"
    rm -f "$f"
  elif git ls-files --error-unmatch "$f" >/dev/null 2>&1 \
    && ! git diff --quiet -- "$f" 2>/dev/null; then
    echo "resetting dirty tracked $f so git merge can proceed"
    git checkout -- "$f"
  fi
done

git fetch --quiet origin "$BRANCH"
git merge --ff-only "origin/$BRANCH"
after="$(git rev-parse HEAD)"

# Upstream Material e621 history powers the landing-page "Avoonix" column.
UPSTREAM_URL="${M_E621_UPSTREAM_REPO:-https://github.com/avoonix/material-e621.git}"
if ! git remote get-url upstream >/dev/null 2>&1; then
  git remote add upstream "$UPSTREAM_URL" || true
fi
git fetch --quiet upstream master 2>/dev/null || git fetch --quiet upstream main 2>/dev/null || true

# Re-apply executable bits on helpers if present in tree.
chmod +x start sync serve.py deploy.sh load-m-e621-env.sh 2>/dev/null || true

cat >"$APP_DIR/.env.local" <<EOF
VITE_CANONICAL_URL=https://${DOMAIN}
VITE_APP_DOMAIN=${DOMAIN}
VITE_ENABLE_GIT_PULL=true
VITE_GOOGLE_SITE_VERIFICATION_META=
EOF

# Ensure a pull token exists for the Settings → Info button.
if [[ ! -s "$CONFIG_DIR/pull_token" ]]; then
  python3 - <<'PY'
import secrets
from pathlib import Path
import os
p = Path(os.path.expanduser("~/.config/m-e621/pull_token"))
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(secrets.token_urlsafe(24) + "\n")
p.chmod(0o600)
print(f"created pull token at {p}")
PY
fi

# Server-side gate for POST /api/git/pull (see serve.py _git_pull_enabled).
mkdir -p "$CONFIG_DIR"
if [[ -f "$CONFIG_DIR/env" ]] && grep -q '^M_E621_GIT_PULL=' "$CONFIG_DIR/env" 2>/dev/null; then
  :
else
  echo "M_E621_GIT_PULL=true" >>"$CONFIG_DIR/env"
fi

need_build=0
if [[ "$before" != "$after" ]]; then
  need_build=1
  echo "updated $before -> $after"
elif [[ ! -d "$APP_DIR/dist" ]]; then
  need_build=1
  echo "dist missing; building"
elif [[ "${M_E621_FORCE_BUILD:-0}" == "1" ]]; then
  need_build=1
  echo "force build requested"
else
  echo "already up to date at $after"
fi

# FurAffinity (and future Python deps): keep .venv in sync with requirements.txt.
if [[ -f "$APP_DIR/requirements.txt" ]]; then
  if command -v uv >/dev/null 2>&1; then
    if [[ ! -d "$APP_DIR/.venv" ]]; then
      (cd "$APP_DIR" && uv venv .venv)
    fi
    (cd "$APP_DIR" && uv pip install -r requirements.txt)
  else
    if [[ ! -d "$APP_DIR/.venv" ]]; then
      python3 -m venv "$APP_DIR/.venv"
    fi
    "$APP_DIR/.venv/bin/pip" install -r "$APP_DIR/requirements.txt"
  fi
fi

if [[ "$need_build" -eq 1 ]]; then
  if [[ ! -d node_modules ]]; then
    npm ci
  else
    npm ci --prefer-offline
  fi
  # Skip vue-tsc in production deploy; faster and less brittle on the slot.
  npm run build-only
  # Bounce only when not called from the in-process pull API.
  if [[ "${M_E621_NO_RESTART:-0}" != "1" ]]; then
    if pgrep -f "$APP_DIR/serve.py" >/dev/null 2>&1; then
      pkill -f "$APP_DIR/serve.py" || true
      rm -f "$CONFIG_DIR/m-e621.pid"
      sleep 1
    fi
  fi
fi

if [[ "${M_E621_NO_RESTART:-0}" != "1" ]]; then
  # Drop the flock before spawning serve.py so the lock cannot stick on FD 9.
  if command -v flock >/dev/null 2>&1; then
    exec 9>&- 2>/dev/null || true
  fi
  # After a code pull, always replace the listener so new serve.py routes load.
  if [[ "$need_build" -eq 1 ]]; then
    M_E621_FORCE_RESTART=1 "$APP_DIR/start"
  else
    "$APP_DIR/start"
  fi
fi
echo "==== $(date -Is) sync done ===="
