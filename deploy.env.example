# Copy to deploy.env (repo root) and/or ~/.config/m-e621/env
# Scripts load both; process env vars still win. Do not commit real values.

# Required for deploy.sh (SSH target + password/secret file for sshpass)
EXPEDITION_HOST=user@your-host.example
EXPEDITION_SECRET=$HOME/.ssh/your_deploy_secret

# App layout on the remote (and locally if you run start/sync there)
M_E621_DIR=$HOME/m-e621
M_E621_PORT=18621
M_E621_HOST=127.0.0.1
M_E621_DOMAIN=localhost
M_E621_BRANCH=master

# Optional FurAffinity session cookies for the serve.py / Vite proxy
# (any browser on this host is authenticated; password login is a fallback)
# FA_COOKIE_A=
# FA_COOKIE_B=
